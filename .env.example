# Endpoint y modelo de llama.cpp (API OpenAI-compatible)
LLM_BASE_URL=http://148.204.112.157:8080
LLM_MODEL=bartowski/Llama-3.2-1B-Instruct-GGUF:Q4_K_M
# Si no tienes modelo embedding dedicado en /v1/models, usa el mismo del chat.
LLM_EMBED_MODEL=bartowski/Llama-3.2-1B-Instruct-GGUF:Q4_K_M

# Compatibilidad legada (si no defines LLM_*, se pueden usar OLLAMA_*)
OLLAMA_MODEL=deepseek-r1:1.5b

# Umbral para marcar respuestas lentas del LLM (en ms)
LLM_SLOW_RESPONSE_MS=15000

# Timeout de cabeceras HTTP (en ms)
LLM_HEADERS_TIMEOUT_MS=180000

# Timeout de recepción de cuerpo HTTP (en ms)
LLM_BODY_TIMEOUT_MS=300000

# Timeout de conexión TCP (en ms)
LLM_CONNECT_TIMEOUT_MS=20000

# Timeout global de la petición al LLM (en ms)
LLM_REQUEST_TIMEOUT_MS=240000

# Límite de caracteres del contexto enviado al LLM
LLM_CONTEXT_MAX_CHARS=2200

# Límite de caracteres del contexto en reintento por input demasiado grande
LLM_CONTEXT_RETRY_MAX_CHARS=900

# Límite de caracteres máximos para embedding (evita "input too large")
LLM_EMBED_MAX_CHARS=1800

# ─── Tamaño de batches para indexación RAG ─────────────────────────────────
# Tamaño mayor = menos chunks = menos embeddings = más rápido
# Pero chunks muy grandes pueden perder granularidad en búsquedas semánticas
# Recomendado: Histórico y RUAA = 50+; PxP y MXG = 15-20; Catálogo = 20
RAG_BATCH_SIZE_PXP=15
RAG_BATCH_SIZE_MXG=15
RAG_BATCH_SIZE_HISTORICO=50
RAG_BATCH_SIZE_RUAA=50
RAG_BATCH_SIZE_CATEG=20
