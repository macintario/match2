# Umbral para marcar respuestas lentas de Ollama (en ms)
OLLAMA_SLOW_RESPONSE_MS=15000

# Timeout de cabeceras HTTP (en ms)
OLLAMA_HEADERS_TIMEOUT_MS=180000

# Timeout de recepción de cuerpo HTTP (en ms)
OLLAMA_BODY_TIMEOUT_MS=300000

# Timeout de conexión TCP (en ms)
OLLAMA_CONNECT_TIMEOUT_MS=20000

# Timeout global de la petición a Ollama (en ms)
OLLAMA_REQUEST_TIMEOUT_MS=240000
